<launch>
    <!-- Map server -->
    <node name="map_server" pkg="map_server" type="map_server" output="screen"
          args="/home/acsdc/Desktop/IRob-main/catkin_ws/src/q_learning_robot/maps/my_map1.yaml">
        <param name="frame_id" value="map"/>
    </node>

    <!-- Q-Learning Node Real -->
    <node pkg="q_learning_robot" type="q_policy_navigator.py" name="q_policy_navigator" output="screen">
        <param name="grid_size" value="52"/>
        <param name="goal_cell" value="[33,40]"/>
    </node>
</launch>