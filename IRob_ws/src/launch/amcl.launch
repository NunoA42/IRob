<launch>
  <!-- ===== Arguments ===== -->
  <arg name="map_file" default="/home/nuno/Desktop/IRob/ros_ws/src/ir_self_localization/maps/my_map1.yaml"/>
  <arg name="use_sim_time" default="false"/>

  <!-- Frames (adapt to your robot) -->
  <arg name="base_frame_id" default="base_link"/>
  <arg name="odom_frame_id" default="odom"/>
  <arg name="global_frame_id" default="map"/>

  <!-- Sensors / topics -->
  <arg name="scan_topic" default="/scan"/>

  <!-- Optional: initial pose (used if you don't set it in RViz) -->
  <arg name="initial_pose_x" default="0.0"/>
  <arg name="initial_pose_y" default="0.0"/>
  <arg name="initial_pose_a" default="0.0"/>

  <!-- ===== Global params ===== -->
  <param name="use_sim_time" value="$(arg use_sim_time)"/>

  <!-- ===== Map server ===== -->
  <node pkg="map_server" type="map_server" name="map_server" args="$(arg map_file)" output="screen"/>

  <!-- ===== AMCL (Adaptive Monte Carlo Localization) ===== -->
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <!-- Frames -->
    <param name="base_frame_id" value="$(arg base_frame_id)"/>
    <param name="odom_frame_id" value="$(arg odom_frame_id)"/>
    <param name="global_frame_id" value="$(arg global_frame_id)"/>

    <!-- Use map topic from map_server -->
    <param name="use_map_topic" value="true"/>

    <!-- Particle filter settings (reasonable defaults) -->
    <param name="min_particles" value="500"/>
    <param name="max_particles" value="2000"/>
    <param name="kld_err" value="0.02"/>
    <param name="kld_z" value="0.99"/>
    <param name="resample_interval" value="1"/>

    <!-- Motion model (diff drive typical); tune alphas for your odometry noise -->
    <param name="odom_model_type" value="diff"/>
    <param name="odom_alpha1" value="0.2"/>
    <param name="odom_alpha2" value="0.2"/>
    <param name="odom_alpha3" value="0.2"/>
    <param name="odom_alpha4" value="0.2"/>

    <!-- Update thresholds: accumulate motion before filter update -->
    <param name="update_min_d" value="0.20"/>
    <param name="update_min_a" value="0.20"/>

    <!-- Laser model (likelihood field is robust and common) -->
    <param name="laser_model_type" value="likelihood_field"/>
    <param name="laser_max_beams" value="60"/>
    <param name="laser_likelihood_max_dist" value="2.0"/>

    <!-- Laser ranges (match your LiDAR) -->
    <param name="laser_min_range" value="0.05"/>
    <param name="laser_max_range" value="12.0"/>

    <!-- Beam model parameters (tune as needed) -->
    <param name="laser_z_hit" value="0.9"/>
    <param name="laser_z_short" value="0.05"/>
    <param name="laser_z_max" value="0.05"/>
    <param name="laser_z_rand" value="0.1"/>
    <param name="laser_sigma_hit" value="0.2"/>
    <param name="laser_lambda_short" value="0.1"/>

    <!-- Initial pose (optional; can also set via RViz "2D Pose Estimate") -->
    <param name="initial_pose_x" value="$(arg initial_pose_x)"/>
    <param name="initial_pose_y" value="$(arg initial_pose_y)"/>
    <param name="initial_pose_a" value="$(arg initial_pose_a)"/>

    <!-- Remap laser topic to your LiDAR feed -->
    <remap from="scan" to="$(arg scan_topic)"/>
  </node>

  <!-- ===== Optional: move_base stack ===== -->
  <!-- If you want full navigation, include your move_base launch here or another file. -->
  <!--
  <include file="$(find your_nav_pkg)/launch/move_base.launch"/>
  -->

  <!-- Notes:
       - AMCL publishes the tf from 'map' to 'odom'. Your odometry/ekf should publish 'odom' -> 'base_link'.
       - Ensure your TF tree is continuous: map -> odom -> base_link -> ... -> laser frame.
  -->
</launch>
