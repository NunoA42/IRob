<launch>
  <!-- 1️⃣ Load your full YAML for all static parameters -->
  <rosparam file="$(find waypoint_navigation)/params/custom_amcl.yaml" command="load"/>

  <!-- 2️⃣ Start AMCL node with critical motion model params explicitly set -->
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <remap from="scan" to="/scan"/>

    <!-- These override dynamic_reconfigure defaults -->
    <param name="odom_alpha1" value="0.3"/>
    <param name="odom_alpha2" value="0.15"/>
    <param name="odom_alpha3" value="0.15"/>
    <param name="odom_alpha4" value="0.3"/>
    <param name="odom_alpha5" value="0.1"/>
  </node>
</launch>

